===========================================================================
jts.Angle:::OBJECT
this != null
===========================================================================
jts.Angle.getTurn(double, double):::ENTER
daikon.Quant.fuzzy.eq(ang1, -4.0) || daikon.Quant.fuzzy.eq(ang1, 0.0) || daikon.Quant.fuzzy.eq(ang1, 10.0)
daikon.Quant.fuzzy.eq(ang2, -10.5) || daikon.Quant.fuzzy.eq(ang2, 0.0) || daikon.Quant.fuzzy.eq(ang2, 1.0)
===========================================================================
jts.Angle.getTurn(double, double):::EXIT
\result == -1 || \result == 1
